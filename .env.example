MARKET_DATA_API_KEY=

# WhatsApp Business API & Notification Channel
WHATSAPP_PROVIDER=MOCK
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TARGET_PHONE=
