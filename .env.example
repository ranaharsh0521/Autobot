# System
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
LIVE_COLLECTOR_ENABLED=false
SCANNER_ENABLED=false
POSITION_MONITOR_ENABLED=false
